# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=normkompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=normkompass
POSTGRES_PORT=5432
PORT=3000
DATABASE_URL=postgres://normkompass:change-me@localhost:5432/normkompass
# local-e5 (default, runs locally) or fake (tests only)
EMBEDDER=local-e5
# Answer generation (POST /ask, pnpm eval:answers). Never commit a real key.
ANTHROPIC_API_KEY=
# A current Claude model id from the Anthropic documentation; the code has no default.
ANSWER_MODEL=claude-opus-5-5
