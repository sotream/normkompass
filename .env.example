# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=normkompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=normkompass
POSTGRES_PORT=5432
PORT=3000
DATABASE_URL=postgres://normkompass:change-me@localhost:5432/normkompass
# local-e5 (default, runs locally) or fake (tests only)
EMBEDDER=local-e5
# Answer generation (POST /ask, pnpm eval:answers). Never commit a real key.
# Provider: claude (default), ollama (a local model; nothing leaves the machine) or openai-compatible
# (any OpenAI-style chat completions endpoint; question and source text are sent to that host).
ANSWER_PROVIDER=claude
ANTHROPIC_API_KEY=
# A current Claude model id from the Anthropic documentation; the code has no default.
ANSWER_MODEL=claude-opus-5-5
# Only for ANSWER_PROVIDER=ollama: name of a model you have pulled, and the server URL.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
# Only for ANSWER_PROVIDER=openai-compatible (uses ANSWER_MODEL too). No defaults in code.
ANSWER_BASE_URL=
ANSWER_API_KEY=
# Minimum pause between requests in milliseconds, to stay inside a free tier's rate limit.
ANSWER_MIN_INTERVAL_MS=
