{
  "name": "normkompass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.16.0",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "spec": "openspec validate --all --strict --no-interactive",
    "ingest": "pnpm --filter @normkompass/corpus build && node packages/corpus/dist/cli/ingest.js",
    "index": "pnpm -r --filter @normkompass/corpus --filter @normkompass/search build && node packages/search/dist/cli/index.js",
    "example": "pnpm -r --filter @normkompass/corpus --filter @normkompass/search --filter @normkompass/example-own-corpus build && node examples/own-corpus/dist/run.js",
    "eval:compare": "pnpm -r --filter @normkompass/eval build && node packages/eval/dist/cli/compare.js",
    "eval:retrieval": "pnpm -r --filter @normkompass/corpus --filter @normkompass/search --filter @normkompass/eval build && node packages/eval/dist/cli/run.js",
    "eval:validate": "pnpm -r --filter @normkompass/corpus --filter @normkompass/search --filter @normkompass/eval build && node packages/eval/dist/cli/run.js --validate-only",
    "eval:answers": "pnpm -r --filter @normkompass/corpus --filter @normkompass/search --filter @normkompass/answer --filter @normkompass/eval build && node packages/eval/dist/cli/answers.js --yes"
  }
}
